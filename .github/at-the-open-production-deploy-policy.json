{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadDeploymentIdentity",
      "Effect": "Allow",
      "Action": "sts:GetCallerIdentity",
      "Resource": "*"
    },
    {
      "Sid": "ManageSstBootstrapBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:GetBucketNotification",
        "s3:GetBucketPolicy",
        "s3:GetBucketTagging",
        "s3:GetBucketVersioning",
        "s3:GetEncryptionConfiguration",
        "s3:ListBucket",
        "s3:ListBucketMultipartUploads",
        "s3:ListBucketVersions"
      ],
      "Resource": [
        "arn:aws:s3:::sst-state-dduurnknawho",
        "arn:aws:s3:::sst-asset-dduurnknawho"
      ]
    },
    {
      "Sid": "ManageSstBootstrapObjects",
      "Effect": "Allow",
      "Action": [
        "s3:AbortMultipartUpload",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:GetObject",
        "s3:GetObjectAttributes",
        "s3:GetObjectTagging",
        "s3:GetObjectVersion",
        "s3:ListMultipartUploadParts",
        "s3:PutObject",
        "s3:PutObjectTagging"
      ],
      "Resource": [
        "arn:aws:s3:::sst-state-dduurnknawho/*",
        "arn:aws:s3:::sst-asset-dduurnknawho/*"
      ]
    },
    {
      "Sid": "ReadSstBootstrapParameters",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters"
      ],
      "Resource": [
        "arn:aws:ssm:us-east-1:493387716836:parameter/sst/bootstrap",
        "arn:aws:ssm:us-east-1:493387716836:parameter/sst/passphrase/*"
      ]
    },
    {
      "Sid": "ManageSstSecrets",
      "Effect": "Allow",
      "Action": [
        "ssm:AddTagsToResource",
        "ssm:DeleteParameter",
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath",
        "ssm:ListTagsForResource",
        "ssm:PutParameter"
      ],
      "Resource": "arn:aws:ssm:us-east-1:493387716836:parameter/sst/*"
    },
    {
      "Sid": "UseSstAssetRepository",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:CompleteLayerUpload",
        "ecr:DescribeImages",
        "ecr:DescribeRepositories",
        "ecr:GetDownloadUrlForLayer",
        "ecr:InitiateLayerUpload",
        "ecr:ListImages",
        "ecr:PutImage",
        "ecr:UploadLayerPart"
      ],
      "Resource": "arn:aws:ecr:us-east-1:493387716836:repository/sst-asset"
    },
    {
      "Sid": "AuthenticateToEcr",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "ManageApplicationBuckets",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": "arn:aws:s3:::at-the-open-production-*"
    },
    {
      "Sid": "ManageApplicationFunctions",
      "Effect": "Allow",
      "Action": "lambda:*",
      "Resource": [
        "arn:aws:lambda:us-east-1:493387716836:function:at-the-open-production-*",
        "arn:aws:lambda:us-east-1:493387716836:function:p-Web*"
      ]
    },
    {
      "Sid": "CreateAndDiscoverLambdaEventSourceMappings",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateEventSourceMapping",
        "lambda:ListEventSourceMappings"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ManageLambdaEventSourceMappings",
      "Effect": "Allow",
      "Action": [
        "lambda:DeleteEventSourceMapping",
        "lambda:GetEventSourceMapping",
        "lambda:ListTags",
        "lambda:TagResource",
        "lambda:UntagResource",
        "lambda:UpdateEventSourceMapping"
      ],
      "Resource": "arn:aws:lambda:us-east-1:493387716836:event-source-mapping:*"
    },
    {
      "Sid": "ManageApplicationQueues",
      "Effect": "Allow",
      "Action": "sqs:*",
      "Resource": "arn:aws:sqs:us-east-1:493387716836:at-the-open-production-*"
    },
    {
      "Sid": "ManageApplicationTables",
      "Effect": "Allow",
      "Action": "dynamodb:*",
      "Resource": "arn:aws:dynamodb:us-east-1:493387716836:table/at-the-open-production-*"
    },
    {
      "Sid": "ManageApplicationLogGroups",
      "Effect": "Allow",
      "Action": "logs:*",
      "Resource": [
        "arn:aws:logs:us-east-1:493387716836:log-group:/aws/lambda/at-the-open-production-*",
        "arn:aws:logs:us-east-1:493387716836:log-group:/aws/lambda/p-Web*"
      ]
    },
    {
      "Sid": "DiscoverApplicationLogGroups",
      "Effect": "Allow",
      "Action": "logs:DescribeLogGroups",
      "Resource": "*"
    },
    {
      "Sid": "ManageApplicationRoles",
      "Effect": "Allow",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:DeleteRolePolicy",
        "iam:DetachRolePolicy",
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListAttachedRolePolicies",
        "iam:ListInstanceProfilesForRole",
        "iam:ListRolePolicies",
        "iam:PutRolePolicy",
        "iam:RemoveRoleFromInstanceProfile",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:UpdateRole",
        "iam:UpdateRoleDescription"
      ],
      "Resource": [
        "arn:aws:iam::493387716836:role/at-the-open-production-*",
        "arn:aws:iam::493387716836:role/produ-Web*"
      ]
    },
    {
      "Sid": "PassApplicationRolesToLambda",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::493387716836:role/at-the-open-production-*",
        "arn:aws:iam::493387716836:role/produ-Web*"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "edgelambda.amazonaws.com",
            "lambda.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "CreateRequiredServiceLinkedRoles",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": [
            "logger.cloudfront.amazonaws.com",
            "replicator.lambda.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "ManageCloudFrontResources",
      "Effect": "Allow",
      "Action": "cloudfront:*",
      "Resource": "*"
    },
    {
      "Sid": "ManageCloudFrontKeyValueStoreEntries",
      "Effect": "Allow",
      "Action": [
        "cloudfront-keyvaluestore:DeleteKey",
        "cloudfront-keyvaluestore:DescribeKeyValueStore",
        "cloudfront-keyvaluestore:GetKey",
        "cloudfront-keyvaluestore:ListKeys",
        "cloudfront-keyvaluestore:PutKey",
        "cloudfront-keyvaluestore:UpdateKeys"
      ],
      "Resource": "arn:aws:cloudfront::493387716836:key-value-store/*"
    },
    {
      "Sid": "ReadProductionCertificate",
      "Effect": "Allow",
      "Action": [
        "acm:DescribeCertificate",
        "acm:GetCertificate"
      ],
      "Resource": "arn:aws:acm:us-east-1:493387716836:certificate/3ee34cd6-92d0-42e3-b878-4a4d5858d8ec"
    },
    {
      "Sid": "ReadResourceTags",
      "Effect": "Allow",
      "Action": [
        "tag:GetResources",
        "tag:GetTagKeys",
        "tag:GetTagValues"
      ],
      "Resource": "*"
    }
  ]
}
